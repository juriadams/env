{
  "name": "@juriadams/env",
  "version": "1.1.1",
  "private": false,
  "description": "A simple and type-safe way to validate environment variables.",
  "files": [
    "package.json",
    "readme.md",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown --clean",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "oxlint --type-aware && oxfmt --check",
    "format": "oxlint --fix --fix-suggestions && oxfmt"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@types/bun": "latest",
    "@types/node": "26.4.1",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "publint": "0.3.24",
    "tsdown": "0.23.0",
    "typescript": "^7"
  }
}
